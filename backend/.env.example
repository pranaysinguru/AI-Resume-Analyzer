# Copy to .env to customize runtime settings
# Default uses local SQLite; switch to PostgreSQL seamlessly:
# RESUMEX_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resumex
RESUMEX_DATABASE_URL=sqlite:///./resumex.db
RESUMEX_MAX_UPLOAD_BYTES=10485760
RESUMEX_ENABLE_DENSE_EMBEDDINGS=true
RESUMEX_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
